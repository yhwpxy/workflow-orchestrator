{
  "name": "vto-server",
  "version": "1.0.0",
  "description": "可视化任务编排器（VTO）服务端：M1 规格解析与任务分解 + M3 执行引擎（负责人 C）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
